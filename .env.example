# Environment Configuration Example

# Application Settings
APP_ENV=development
PROJECT_NAME="SOP Copilot"
VERSION=1.0.0
DEBUG=true

# API Settings
API_V1_STR=/api/v1

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# Langfuse Settings
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM Settings — DeepSeek (OpenAI-compatible API)
OPENAI_API_KEY="your-deepseek-api-key"
OPENAI_BASE_URL=https://api.deepseek.com
DEFAULT_LLM_MODEL=deepseek-v4-pro
GRADE_LLM_MODEL=deepseek-v4-flash
DEFAULT_LLM_TEMPERATURE=0.2
SESSION_NAMING_ENABLED=true

# Agentic RAG Settings
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=sop_documents
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
RAG_MAX_REWRITES=2
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=20

# Hybrid retrieval (vector + BM25, fused via reciprocal rank fusion)
RAG_HYBRID_SEARCH_ENABLED=true
RAG_CANDIDATE_K=15
RAG_RRF_K=60
RAG_SCORE_THRESHOLD=1.2

# Long-term memory (mem0) — DeepSeek LLM + local bge-m3 embedder, pgvector store
LONG_TERM_MEMORY_ENABLED=true
LONG_TERM_MEMORY_MODEL=deepseek-v4-flash
LONG_TERM_MEMORY_EMBEDDER_MODEL=BAAI/bge-m3
LONG_TERM_MEMORY_EMBEDDER_DIMS=1024
LONG_TERM_MEMORY_COLLECTION_NAME=longterm_memory

# JWT Settings
JWT_SECRET_KEY="your-jwt-secret-key"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# Database Settings
POSTGRES_HOST=db
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PORT=5432
POSTGRES_PASSWORD=mypassword
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"

# Profiling Settings
PROFILING_DIR=/tmp/fastapi_profiles
PROFILING_THRESHOLD_SECONDS=2.0

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# Durable local incident snapshots and mock tickets (single-host storage)
SOP_INCIDENT_DB=./data/incidents.sqlite3
